# InGPT Configuration
PORT=5000
NODE_ENV=development

# Core AI Credentials
# Provide your OpenAI API key for real-time speech and chat
OPENAI_API_KEY=

# OpenAI Models
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-12-17
OPENAI_VOICE=alloy

# Persistent Storage
DATABASE_PATH=./data/ingpt.db

# Live External APIs (Optional - fallbacks available)
# Weather uses free Open-Meteo API by default (no key required!)
# Search uses live DuckDuckGo / Wikipedia API by default (no key required!)
